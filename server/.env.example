# Server
PORT=4000
NODE_ENV=development

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/mountroof
# Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/mountroof
MONGODB_URI=mongodb://127.0.0.1:27017/mountroof

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins allowed to call the API
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Seed admin (used by npm run seed)
ADMIN_EMAIL=admin@mountroof.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=MountRoof Admin

# Email — enquiry notifications to SALES_EMAIL
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SALES_EMAIL=Krishnafabtech@gmail.com

# Public API URL used in uploaded image links (optional; defaults to request host)
# PUBLIC_API_URL=http://localhost:4000

# Image uploads — local disk by default (server/uploads).
# Set all three Cloudinary vars to upload to Cloudinary instead.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=mountroof
