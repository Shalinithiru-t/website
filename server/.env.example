# Server
PORT=4000
NODE_ENV=development

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/mountroof
# Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/mountroof
MONGODB_URI=mongodb://127.0.0.1:27017/mountroof

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins allowed to call the API
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Seed admin (used by npm run seed)
ADMIN_EMAIL=admin@mountroof.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=MountRoof Admin

# Email (Phase 3 — placeholders for now)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SALES_EMAIL=sales@mountroof.com
